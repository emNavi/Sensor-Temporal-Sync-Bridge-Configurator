            "content": "<template>\n    <el-aside width=\"200px\" style=\"background-color: #f2f2f2; padding: 10px; height: 80vh;\">\n        <el-menu \n            :default-active=\"route.path\"   \n            class=\"el-menu-vertical-demo\"\n            router                        \n        >\n            <el-menu-item index=\"/\">\n                <el-icon><House /></el-icon>\n                <span>总览</span>\n            </el-menu-item>\n            <el-menu-item index=\"/firmware\">\n                <el-icon><Switch /></el-icon>\n                <span>固件</span>\n            </el-menu-item>\n            <el-menu-item index=\"/gyro_calib\">\n                <el-icon><Aim /></el-icon>\n                <span>Gyro校准</span>\n            </el-menu-item>\n            <el-menu-item index=\"/acc_calib\">\n                <el-icon><Aim /></el-icon>\n                <span>Acc校准</span>\n            </el-menu-item>\n            <!-- <el-menu-item index=\"/mag_calib\">\n                <el-icon><Aim /></el-icon>\n                <span>Mag校准</span>\n            </el-menu-item> -->\n            <el-menu-item index=\"/log\">\n                <el-icon><ChatDotSquare /></el-icon>\n                <span>Log</span>\n            </el-menu-item>\n            <el-menu-item index=\"/setting\">\n                <el-icon><SetUp /></el-icon>\n                <span>配置</span>\n            </el-menu-item>\n        </el-menu>\n    </el-aside>\n</template>\n\n<script setup>\nimport { useRoute } from 'vue-router'\nimport { ref, onMounted } from 'vue';\nimport { House, Switch, SuccessFilled, WarningFilled, CircleCloseFilled, Aim, ChatDotSquare, SetUp } from '@element-plus/icons-vue'\nimport { de } from 'element-plus/es/locales.mjs';\nimport { ElNotification } from 'element-plus'\n\n\nimport { useRouter } from 'vue-router';\n\nconst route = useRoute()\n\nconst handleMenuSelect = (index) => {\n    switch (index) {\n        case '1':\n            router.push('/');\n            break;\n        case '3':\n            router.push('/gyro_calib');\n            break;\n        case '2':\n            router.push('/firmware');\n            break;\n        case '4':\n            router.push('/acc_calib');\n            break;\n        case '5':\n            router.push('/mag_calib');\n            break;\n        case '6':\n            router.push('/log');\n            break;\n        case '7':\n            router.push('/setting');\n            break;\n        default:\n            ElNotification({\n                title: '未知菜单',\n                message: '未识别的菜单选项',\n                type: 'info',\n            });\n    }\n};\n// window.electronAPI.onUpdateNetDevices((value) => {\n//     devicesList.value = JSON.parse(value);\n//     console.log(\"onUpdateNetDevices\",value);\n// })\n\n// window.electronAPI.onUpdateNetcardIps((value) => {\n//     ipRanges = JSON.parse(value);\n//     console.log(\"onUpdateNetcardIps\",value);\n// })\n\n// document.addEventListener('keydown', (event) => {\n//   if (event.key === 'F5' || (event.ctrlKey && event.key === 'r') || (event.metaKey && event.key === 'r')) {\n//     event.preventDefault();\n//   }\n// });\n\n</script>\n\n<style>\n.el-table .success-row {\n    /* --el-table-tr-bg-color: var(--el-color-warning-light-9); */\n    --el-table-tr-bg-color: #45553d96;\n}\n</style>"
